  },
  "dependencies": {
    "@kdhelpbook/cf-registry": "0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.9.3",
    "wrangler": "~4.114.0"
  }
}
