{
  "name": "khb-cf-registry-instance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "khb-cf-registry validate khb-registry.yml",
    "build": "khb-cf-registry prepare khb-registry.yml",
    "typecheck": "npm run build && tsc --noEmit",
