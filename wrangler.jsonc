{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "docs-duma-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "preview_urls": false,
  "assets": {
    "directory": "./.khb-registry/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/docsets.json",
      "/config.json",
      "/d/*",
      "/publish/*",
      "/mcp",
    ],
  },
  "r2_buckets": [
    {
      "binding": "DOCSETS",
      "bucket_name": "docs-duma-dev",
    },
  ],
}
